<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.HeroCardController" spacing="8.0" prefWidth="260.0" maxWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d9dee7; -fx-border-radius: 10; -fx-padding: 16;">
       <children>
              <Label fx:id="nameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
              <Label fx:id="typeLabel" style="-fx-text-fill: #596579;"/>
              <Label fx:id="roleLabel" wrapText="true"/>
              <Label fx:id="playstyleLabel" wrapText="true"/>
              <Label fx:id="tagsLabel" wrapText="true"/>
       </children>
</VBox>
