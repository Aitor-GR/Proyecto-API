<?xml version="1.0" encoding="UTF-8"?>
<!-- Vista principal con el buscador, la exportación y las tarjetas. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.HeroCardsViewController" spacing="8.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
    <HBox spacing="8.0">
        <ComboBox fx:id="searchFieldSelector" prefWidth="140.0"/>
        <TextField fx:id="searchField" promptText="Buscar héroe..." HBox.hgrow="ALWAYS"/>
        <Button fx:id="exportButton" text="Exportar" onAction="#exportData"/>
    </HBox>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <content>
            <TilePane fx:id="cardsPane" hgap="16.0" vgap="16.0" prefColumns="3">
                <padding>
                    <Insets top="8.0" right="0.0" bottom="0.0" left="0.0"/>
                </padding>
            </TilePane>
        </content>
    </ScrollPane>
</VBox>
