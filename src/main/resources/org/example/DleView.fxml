<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.DleController" spacing="12.0">
    <padding>
        <Insets top="32.0" right="40.0" bottom="32.0" left="40.0"/>
    </padding>
    <Label text="DLE de héroes" style="-fx-font-size: 26px; -fx-font-weight: bold;" alignment="CENTER"/>
    <Label text="Adivina el héroe del día" style="-fx-font-size: 16px;" alignment="CENTER"/>
    <Label fx:id="streakLabel" text="Racha: 0 días" style="-fx-font-weight: bold;"/>
    <TextField fx:id="guessField" promptText="Escribe el nombre del héroe"
               maxWidth="320.0" onAction="#checkGuess"/>
    <ListView fx:id="suggestionsList" prefHeight="100.0" maxWidth="320.0"
              visible="false" managed="false"/>
    <Button fx:id="guessButton" text="Comprobar" onAction="#checkGuess" maxWidth="320.0"/>
    <Label fx:id="feedbackLabel" wrapText="true"/>
    <TableView fx:id="attemptsTable" prefHeight="280.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="imageColumn" text="Image" prefWidth="90.0"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="160.0"/>
            <TableColumn fx:id="genderColumn" text="Gender" prefWidth="120.0"/>
            <TableColumn fx:id="gunTagColumn" text="Gun tag" prefWidth="120.0"/>
            <TableColumn fx:id="heroTypeColumn" text="Hero type" prefWidth="140.0"/>
        </columns>
    </TableView>
    <Button text="Volver al listado de cards" onAction="#backToCards"/>
</VBox>
